# Test environment. Copy to .env.test and point DATABASE_URL at a DISPOSABLE
# database — integration tests create and delete rows.
NODE_ENV=test
PORT=5001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/projectsphere?schema=public
JWT_ACCESS_SECRET=test_access_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=test_refresh_secret_at_least_32_characters_long
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=test
SMTP_PASS=test
MAIL_FROM_EMAIL=no-reply@projectsphere.test
