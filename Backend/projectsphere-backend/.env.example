# ==============================================
# ProjectSphere Backend — Environment Variables
# Copy this file to `.env` and fill in real values.
# The app validates these on startup (src/config/env.ts)
# and will CRASH with a clear message if any are invalid.
# ==============================================

# ---- Server ----
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
# Comma-separated list of allowed origins for CORS
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database (PostgreSQL / Neon) ----
# Local:  postgresql://postgres:password@localhost:5432/projectsphere?schema=public
# Neon:   postgresql://user:pass@ep-xxx.region.aws.neon.tech/projectsphere?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/projectsphere?schema=public

# ---- JWT ----
# Use long random strings. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
JWT_REFRESH_REMEMBER_DAYS=30

# ---- Email (Nodemailer) ----
# For dev, use Mailtrap (https://mailtrap.io) — safe sandbox inbox.
# For prod with Gmail, create an App Password.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
MAIL_FROM_NAME=ProjectSphere
MAIL_FROM_EMAIL=no-reply@projectsphere.dev

# ---- OAuth: Google ----
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ---- OAuth: GitHub ----
# https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback

# ---- Frontend redirect after OAuth success ----
# Backend redirects here with tokens after OAuth completes.
OAUTH_SUCCESS_REDIRECT=http://localhost:5173/oauth/callback
OAUTH_FAILURE_REDIRECT=http://localhost:5173/login?error=oauth

# ---- Cloudinary (media uploads) ----
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=projectsphere

# ---- Gemini AI ----
# https://aistudio.google.com/app/apikey  (leave blank to disable AI endpoints)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_RATE_LIMIT_PER_HOUR=10
